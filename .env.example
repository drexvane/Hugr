# Copy to `.env` (gitignored) and fill in. Nothing in this repository holds a key,
# and none is needed to build, test, or run the dashboard: the agent's tests use a
# scripted model, and `dtp ask --stub` answers without a network call.
#
# Only the first line is a secret. Anything already exported wins over this file, so
# a stale value here cannot override a key set for one run.

ANTHROPIC_API_KEY=

# Optional. The model the agent calls; defaults to claude-sonnet-5.
# DTP_AGENT_MODEL=claude-sonnet-5

# The dashboard's password gate is deliberately NOT read from this file. It is off
# unless the variable is in the environment, which is where a hosting platform puts
# it, and a `.env` that silently switched it on or off would be the wrong place for
# that decision to live. To try it locally:
#
#     DTP_DASHBOARD_PASSWORD=a-long-enough-secret streamlit run dashboard/app.py
#
# `DTP_DASHBOARD_PASSWORD_SHA256` takes the hex digest instead. Read
# `src/dtp/dashboard/auth.py` first: it is a shared-secret gate, not access control.
