# Copy to `.env` (gitignored) and fill in. Nothing in this repository holds a key,
# and none is needed to build, test, or run the dashboard: the agent's tests use a
# scripted model, and `dtp ask --stub` answers without a network call.
#
# Only the first line is a secret. Anything already exported wins over this file, so
# a stale value here cannot override a key set for one run.

ANTHROPIC_API_KEY=

# Optional. The model the agent calls; defaults to claude-sonnet-5.
# DTP_AGENT_MODEL=claude-sonnet-5
